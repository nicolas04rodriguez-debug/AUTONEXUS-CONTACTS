# ---- Database (SQLite by default; swap for Postgres with no code changes) ----
DATABASE_URL=sqlite:///data/urbex_crm.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/urbex

# ---- Telegram (phone control surface) ----
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to control the bot. REQUIRED.
TELEGRAM_ALLOWED_USER_IDS=

# ---- LLM provider: anthropic | openai | xai | hermes | openai_compatible ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
XAI_API_KEY=
XAI_MODEL=grok-4
# Any OpenAI-compatible endpoint (Nous Hermes, Ollama, vLLM, OpenRouter...)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# ---- Email sending: gmail_api (recommended) | smtp ----
MAIL_BACKEND=gmail_api
GMAIL_CREDENTIALS_FILE=config/gmail_credentials.json
GMAIL_TOKEN_FILE=config/gmail_token.json
FROM_NAME=Nicolas Rodriguez
FROM_EMAIL=
# SMTP fallback (Gmail app password or Workspace SMTP relay)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- Email finding ----
APOLLO_API_KEY=
HUNTER_API_KEY=
MIN_CONTACTS_PER_COMPANY=3
# Verify guessed emails by SMTP handshake (often blocked; MX check always runs)
SMTP_VERIFY_GUESSES=false

# ---- Sending policy ----
SEND_TIMEZONE=Europe/Madrid
SEND_WINDOW_START=09:00
SEND_WINDOW_END=18:00
SEND_WEEKDAYS_ONLY=true
DAILY_SEND_CAP=40
MIN_SECONDS_BETWEEN_SENDS=90
# Follow-ups drafted by the scheduler are sent without a Telegram approval tap
AUTO_APPROVE_FOLLOWUPS=true
# First-touch emails always require approval unless this is true
AUTO_APPROVE_FIRST_TOUCH=false

# ---- Identity used in templates ----
SENDER_FULL_NAME=Nicolas Rodriguez
SENDER_TITLE=Founder, Urbex
SENDER_PHONE=
SENDER_LINKEDIN=
COMPANY_WEBSITE=https://urbex.example
# Postal address is legally required in commercial email in the EU/Spain (LSSI)
COMPANY_POSTAL_ADDRESS=
